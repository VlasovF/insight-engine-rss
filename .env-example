# Project
PROJECT_NAME=insight-engine
PROJECT_PREFIX=ie

# Docker
COMPOSE_PROJECT_NAME=${PROJECT_NAME}

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_NETWORK=ollama-network

# Database
SQLITE_PATH=./app.db
CHROMA_PATH=./chroma_data

# Logs
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log