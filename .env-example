# Project
PROJECT_NAME=insight-engine
PROJECT_PREFIX=ie

# Docker
COMPOSE_PROJECT_NAME=${PROJECT_NAME}

# Backend
BACKEND_PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Frontend
FRONTEND_PORT=5173

# Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_NETWORK=ollama-network
OLLAMA_EMBED_MODEL=mxbai-embed-large:335m
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60
OLLAMA_EMBED_BATCH_SIZE=10
OLLAMA_EMBED_DELAY=0.1

# Database
SQLITE_PATH=./app.db
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=events

# Logs
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log
LOG_JSON=true

# Pipeline
PIPELINE_MAX_EVENTS=10000
DUPLICATE_THRESHOLD=0.92
INSIGHT_TOP_K=5